<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ytdlpjava.controller.AppController">
   <children>
      <Label alignment="CENTER" layoutX="216.0" layoutY="16.0" prefHeight="50.0" prefWidth="163.0" text="Maz Media Downloader" textAlignment="CENTER">
         <font>
            <Font size="15.0" />
         </font></Label>
      <Label fx:id="percentageLabel" alignment="CENTER" layoutX="221.0" layoutY="222.0" prefHeight="17.0" prefWidth="149.0" textAlignment="CENTER" />
      <ProgressBar fx:id="progressBar" layoutX="196.0" layoutY="247.0" prefWidth="200.0" progress="0.0" />
      <Label layoutX="242.0" layoutY="84.0" text="Paste the URL below" />
      <TextField fx:id="urlField" layoutX="221.0" layoutY="109.0" prefHeight="27.0" prefWidth="149.0" promptText="https://www....." />
      <Button fx:id="downloadBtn" layoutX="246.0" layoutY="276.0" mnemonicParsing="false" onAction="#handleDownload" prefHeight="25.0" prefWidth="89.0" text="Download">
         <graphic>
            <FontIcon iconLiteral="anto-download" />
         </graphic>
      </Button>
      <Label layoutX="255.0" layoutY="146.0" text="Download Path" />
      <TextField fx:id="pathField" layoutX="220.0" layoutY="171.0" prefHeight="27.0" prefWidth="127.0" promptText="C:\Users\..." />
      <Button fx:id="downloadBtn1" cancelButton="true" layoutX="343.0" layoutY="171.0" mnemonicParsing="false" onAction="#handleBrowse" prefHeight="27.0" prefWidth="30.0">
         <graphic>
            <FontIcon iconLiteral="anto-folder-open" />
         </graphic>
      </Button>
   </children>
</AnchorPane>
